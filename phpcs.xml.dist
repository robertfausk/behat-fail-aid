<?xml version="1.0"?>
<ruleset name="behat-fail-aid">
    <description>PHP_CodeSniffer configuration</description>

    <file>src</file>
    <file>tests</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="p"/>

    <rule ref="PSR12">
        <!-- Allow longer lines -->
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!-- Test methods use snake_case naming convention -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Test files may contain multiple classes (inline mocks/helpers) -->
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
