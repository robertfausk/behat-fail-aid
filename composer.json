{
  "name": "robertfausk/behat-fail-aid",
  "type": "behat-extension",
  "description": "Get more out of your test suite by getting it to work with you when tests fail. Screenshots and more. Works with Goutte and MinkExtension.",
  "keywords": ["behat", "behat-screenshot", "screenshot", "error", "fail", "behat-fail", "behat-error", "behat-exception"],
  "license": "MIT",
  "authors": [
    {
      "name": "Robert Freigang",
      "email": "robertfreigang@gmx.de"
    }
  ],
  "require": {
    "php": ">=8.3",
    "behat/behat": "^3.5 || ^4.0",
    "behat/mink": "*@stable",
    "friends-of-behat/mink-extension": "^2.7",
    "behat/mink-selenium2-driver": "~1.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "behat/mink-goutte-driver": "^2.0",
    "g1a/composer-test-scenarios": "^3",
    "matthiasnoback/symfony-config-test": "^5"
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "FailAid\\": "src/"
    }
  },
  "scripts": {
    "tests": "./bin/run-tests.sh",
    "tests:unit": "./vendor/bin/phpunit -c tests",
    "tests:behat": "./vendor/bin/behat"
  },
  "extra": {
    "scenarios": {
      "behat3": {
        "require": {
          "behat/behat": "^3.5",
          "friends-of-behat/mink-extension": "^2.7"
        }
      },
      "behat4": {
        "require": {
          "behat/behat": "^4.0",
          "friends-of-behat/mink-extension": "^3.0@alpha"
        }
      }
    }
  },
  "config": {
    "allow-plugins": {
      "g1a/composer-test-scenarios": true
    }
  }
}
